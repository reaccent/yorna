{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yorna main window: vault read/write inside AppData, image/sound pickers, reveal vault folder",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive"
  ]
}
